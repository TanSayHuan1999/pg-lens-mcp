{
  "name": "pg-lens-mcp",
  "version": "0.1.0",
  "description": "Read-only PostgreSQL explainer MCP server",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --external:pg-native --banner:js=\"import { createRequire } from \"node:module\"; const require = createRequire(import.meta.url);\" --outfile=dist/pg-lens.mjs",
    "eval": "tsx evals/run.ts",
    "eval:protocol": "node evals/protocol-evals.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
