{
  "name": "@tansayhuan1999/pg-lens-mcp",
  "version": "0.2.0",
  "description": "Read-only PostgreSQL explainer MCP server",
  "main": "dist/pg-lens.mjs",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/build-bundle.mjs",
    "eval": "tsx evals/run.ts",
    "eval:protocol": "node evals/protocol-evals.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgresql",
    "postgres",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "bin": {
    "pg-lens-mcp": "dist/pg-lens.mjs"
  },
  "files": [
    "dist/pg-lens.mjs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanSayHuan1999/pg-lens-mcp.git"
  },
  "homepage": "https://github.com/TanSayHuan1999/pg-lens-mcp#readme",
  "bugs": {
    "url": "https://github.com/TanSayHuan1999/pg-lens-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
